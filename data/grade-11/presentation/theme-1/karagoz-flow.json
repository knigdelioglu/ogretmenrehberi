    {
      "id": "s16-process",
      "source_record_id": "T01-S0005",
      "layout": "process",
      "content": {
        "lead": "Ön bilgiyi birlikte harekete geçirin. Bu aşamada hazır Karagöz bilgisi anlatmak yerine öğrencinin görsel ve ön bilgilerinden hareket etmesini sağlayın.",
        "items": [
          "Altı kişilik gruplar oluşturun.",
          "Üç bilgi/düşünce kartı üzerinden kısa grup çalışması yapın.",
          "Görsellerdeki tipleri görünüş, konuşma, eğitim ve sosyal çevre ipuçlarıyla inceleyin."
        ]
      }
    },
    {
      "id": "s16-q1",
      "source_record_id": "T01-S0005",
      "answer_id": "T1-P16-Q01",
      "layout": "question"
    },
    {
      "id": "s16-q2",
      "source_record_id": "T01-S0005",
      "answer_id": "T1-P16-Q02",
      "layout": "question"
    },
    {
      "id": "s16-q3",
      "source_record_id": "T01-S0005",
      "answer_id": "T1-P16-Q03",
      "layout": "question"
    },
    {
      "id": "s17-process",
      "source_record_id": "T01-S0006",
      "layout": "process",
      "content": {
        "lead": "Düşün → Eşleş → Paylaş",
        "items": [
          "Öğrenci önce bireysel olarak düşünür.",
          "Bir arkadaşıyla görüşünü karşılaştırır.",
          "İkili grup ulaştığı sonucu sınıfla paylaşır.",
          "Bu aşamada Karagöz ve Hacivat'ın kişilik özelliklerini hazır liste hâlinde vermeyin."
        ]
      }
    },
    {
      "id": "s17-q1",
      "source_record_id": "T01-S0006",
      "answer_id": "T1-P17-Q01",
      "layout": "question"
    },

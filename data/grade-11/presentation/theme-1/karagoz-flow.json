      "layout": "reference",
      "content": {
        "lead": "Karagöz oyununun temel bölümleri",
        "sections": [
          {
            "title": "Mukaddime",
            "body": "Giriş bölümü."
          },
          {
            "title": "Muhavere",
            "body": "Karagöz ile Hacivat arasındaki söyleşme bölümü."
          },
          {
            "title": "Fasıl",
            "body": "Oyunun asıl olayının işlendiği bölüm."
          },
          {
            "title": "Bitiş",
            "body": "Oyunun kapanış bölümü."
          }
        ],
        "note": "Önce kitabın örnekleri üzerinden öğrencinin bölümleri fark etmesini sağlayın; bu şemayı etkinlik sonunda hafıza desteği olarak gösterin."
      }

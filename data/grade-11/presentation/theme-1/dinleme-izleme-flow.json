      "density": "compact",
      "prompt": "Dinleme / izleme gözlem kontrolü",
      "prompt_mode": "VERIFIED_SUMMARY",
      "content": {
        "lead": "Süreç boyunca aşağıdaki davranışların gerçekleşip gerçekleşmediğini gözlemleyin.",
        "items": [
          "Dinleme/izlemeye hazırlık yaptı ve amacını belirledi.",
          "İçerikle ilgili ön tahminde bulundu.",
          "Ortam ve metin kaynaklı iletişim engellerini azalttı.",
          "Uygun dinleme/izleme yöntemine karar verdi.",
          "Dikkatini yoğunlaştırarak ve başkalarını rahatsız etmeden izledi.",
          "Önemli gördüğü yerler hakkında kısa notlar aldı."
        ]
      }

#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
JAR="$ROOT/gradle/wrapper/gradle-wrapper.jar"
EXPECTED="81a82aaea5abcc8ff68b3dfcb58b3c3c429378efd98e7433460610fecd7ae45f"
URL="https://services.gradle.org/distributions/gradle-8.13-wrapper.jar"

sha256() { shasum -a 256 "$1" | awk '{print $1}'; }

if [[ ! -f "$JAR" ]] || [[ "$(sha256 "$JAR")" != "$EXPECTED" ]]; then
  command -v curl >/dev/null || { echo "curl is required to bootstrap Gradle." >&2; exit 1; }
  mkdir -p "$(dirname "$JAR")"
  TMP="$(mktemp)"
  trap 'rm -f "$TMP"' EXIT
  curl --fail --location --retry 3 --silent --show-error "$URL" --output "$TMP"
  if [[ "$(sha256 "$TMP")" != "$EXPECTED" ]]; then
    echo "Gradle 8.13 wrapper JAR SHA-256 mismatch; refusing to execute." >&2
    exit 1
  fi
  mv "$TMP" "$JAR"
  trap - EXIT
fi

exec java -cp "$JAR" org.gradle.wrapper.GradleWrapperMain "$@"
